+def test_the_unclipped_gate_is_the_command_it_has_always_been(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """The tiny certificate is refused without the clip, on Condition 5' and nothing else."""
+    path = _write(tmp_path, _record(None, "0"))
+    assert gate_main([str(path)]) == 1
+    printed = capsys.readouterr().out
+    assert "corner clip" not in printed
+    assert "Condition 5'" in printed
