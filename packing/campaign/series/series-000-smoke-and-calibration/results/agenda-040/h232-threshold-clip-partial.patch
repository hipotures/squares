diff --git a/packing/tests/test_threshold_corner_clip.py b/packing/tests/test_threshold_corner_clip.py
new file mode 100644
index 00000000..50c80109
--- /dev/null
+++ b/packing/tests/test_threshold_corner_clip.py
@@ -0,0 +1,471 @@
+"""Controls for the corner clip on the threshold routes.
+
+The clip is `sqpack.fractional.corner_clip`'s, admitted on the point routes in 167a4b05
+and threaded here without a line of new geometry: the sweep meets it through the centre
+domain its event grid is built on, and the interval search inherits the point route's
+exclusion, witness and split rules wholesale. What has to be controlled is therefore not
+the predicate -- `tests/test_fractional_corner_clip.py` holds that -- but the threading:
+
+* that an unclipped threshold decision is the one this repository has always made, held
+  to T-025's retained certificate, on the numbers *and* on the box counts;
+* that a clipped decision changes the least charge in the direction and by the amount a
+  hand computation says it must, on a fixture small enough to do that computation in;
+* that the two routes still agree on the number they produce under the clip;
+* that the gate's variant policy is `devtools.decide_certificate`'s, both ways round: a
+  class record is refused without the flag and an unconditional one with it.
+"""
+
+from __future__ import annotations
+
+import json
+from fractions import Fraction
+from pathlib import Path
+
+import pytest
+
+from devtools.decide_threshold_certificate import load as gate_load
+from devtools.decide_threshold_certificate import main as gate_main
+from sqpack.fractional.corner_clip import CornerClip, EmptyClippedDomainError
+from sqpack.fractional.threshold import (
+    CONDITION_5_PRIME,
+    ThresholdAtom,
+    ThresholdCertificate,
+    minimum_charge,
+    verify_threshold,
+)
+from sqpack.fractional.threshold_interval import (
+    CONDITION_5,
+    exact_charge_at_witness,
+    verify_threshold_by_intervals,
+)
+
+PACKING = Path(__file__).resolve().parents[1]
+RETAINED = PACKING / "cases" / "n11_threshold_certificate" / "certificate.json"
+
+
+# --- the unclipped route is byte-for-byte what it was -------------------------
+
+#: What the exact sweep read at three directions of T-025's retained certificate, and
+#: what the interval route read at two of the doubled net's, *measured on the code as it
+#: stood before the clip was threaded through this module*. They are the control on the
+#: default path: a clip argument that reached any arithmetic, or a domain built one event
+#: differently, would move one of these. The box counts are included deliberately --
+#: they are the search's own trace and move on far less than a verdict does.
+RETAINED_EXACT = {
+    0: Fraction(1000002031, 1000000000),
+    90: Fraction(100000203, 100000000),
+    180: Fraction(1000002031, 1000000000),
+}
+RETAINED_INTERVAL = {
+    "0": (1000002031, 1000002031, 3639, 0),
+    "90'": (1000002030, 1000002030, 4119, 0),
+}
+
+
+@pytest.fixture(scope="module")
+def retained() -> ThresholdCertificate:
+    certificate, _ = gate_load(RETAINED.read_bytes())
+    return certificate
+
+
+@pytest.mark.parametrize("index", sorted(RETAINED_EXACT))
+def test_the_unclipped_sweep_reads_the_retained_certificate_unchanged(
+    retained: ThresholdCertificate, index: int
+) -> None:
+    """The retained example decides to the same digit with the clip threaded through."""
+    charge, _ = minimum_charge(
+        retained.atoms,
+        retained.threshold_atoms,
+        retained.directions[index],
+        retained.outer_side,
+        retained.square_side,
+    )
+    assert charge == RETAINED_EXACT[index]
+    # The same call with an explicit ``clip=None`` is the same call: the default path is
+    # not a second path that happens to agree.
+    assert (
+        minimum_charge(
+            retained.atoms,
+            retained.threshold_atoms,
+            retained.directions[index],
+            retained.outer_side,
+            retained.square_side,
+            clip=None,
+        )[0]
+        == charge
+    )
+
+
+def test_the_unclipped_interval_route_searches_the_retained_certificate_unchanged(
+    retained: ThresholdCertificate,
+) -> None:
+    """Same bounds, same enclosure, same boxes, same stalls at the searched directions."""
+    verdict = verify_threshold_by_intervals(
+        retained, enclose=True, directions=tuple(RETAINED_INTERVAL)
+    )
+    assert verdict.enclosure == (RETAINED_EXACT[90], RETAINED_EXACT[90])
+    read = {
+        outcome.label: (outcome.lower, outcome.upper, outcome.boxes, outcome.stalled)
+        for outcome in verdict.directions
+    }
+    assert read == RETAINED_INTERVAL
+
+
+# --- the synthetic fixture the clip is load-bearing on ------------------------
+
+# A container, a shrink and a two-direction net small enough to decide in milliseconds by
+# both routes, carrying two ``2-of-3`` atoms and no point atom at all. The numbers are
+# chosen so the direction-0 charge can be read off by hand; the derivation is in
+# `test_the_clip_turns_the_uncharged_corner_placement_into_a_charged_one`. ``n = 5`` only
+# to clear Condition 2' with room to spare.
+TINY_SIDE = Fraction(19, 10)
+TINY_SHRINK = Fraction(7, 10)
+TINY_NET = (Fraction(0), Fraction(5, 12))
+#: The offset of each atom's outer tokens from the container centre.
+TINY_OFFSET = Fraction(1, 5)
+TINY_DEPTH = Fraction(1)
+
+
+def _tiny_certificate(side: Fraction = TINY_SIDE) -> ThresholdCertificate:
+    """Two ``2-of-3`` atoms of weight 1, collinear through the centre, one per axis.
+
+    The pair is the D4 orbit of either one of them, so Condition 1' holds and the fixture
+    can be put through the whole of `verify_threshold`, not only through one direction.
+    """
+    centre = side / 2
+    horizontal = ThresholdAtom(
+        (
+            (centre - TINY_OFFSET, centre),
+            (centre, centre),
+            (centre + TINY_OFFSET, centre),
+        ),
+        2,
+        Fraction(1),
+    )
+    vertical = ThresholdAtom(
+        (
+            (centre, centre - TINY_OFFSET),
+            (centre, centre),
+            (centre, centre + TINY_OFFSET),
+        ),
+        2,
+        Fraction(1),
+    )
+    return ThresholdCertificate(
+        n=5,
+        outer_side=side,
+        square_side=TINY_SHRINK,
+        atoms=(),
+        threshold_atoms=(horizontal, vertical),
+        half_tangents=TINY_NET,
+    )
+
+
+def _tiny_clip(side: Fraction = TINY_SIDE) -> CornerClip:
+    return CornerClip(side, TINY_SHRINK, TINY_DEPTH)
+
+
+def test_the_clip_turns_the_uncharged_corner_placement_into_a_charged_one() -> None:
+    """The one number in this file computed by hand, at the axis-aligned direction.
+
+    With ``L = 19/10``, ``B = 7/10`` and ``h = B/2 = 7/20`` the centres run over
+    ``[7/20, 39/20]^2`` and the container centre is ``c = 19/20``.
+
+    *Unclipped.* The core centred at ``(7/20, 7/20)`` is ``[0, 7/10]^2``, and every one
+    of the six token points has a coordinate equal to ``19/20 > 7/10``, so it holds no
+    token at all: neither atom reaches its threshold and the charge there is ``0``.
+
+    *Clipped at ``d = 1``.* At this direction ``reach = B max(|cos|, |sin|) = B``, so the
+    four kept half-planes are ``x + y >= d + B = 17/10``, ``x + y <= 2L - d - B = 21/10``
+    and ``|x - y| <= L - d - B = 1/5``: the diamond of half-diagonal ``1/5`` about ``c``,
+    on which ``|x - c| <= 1/5`` and ``|y - c| <= 1/5``.
+
+    Take a centre there and the horizontal atom, whose tokens sit at ``x`` in
+    ``c - 1/5, c, c + 1/5`` and ``y = c``. Every token is within ``1/5 < h`` of ``c`` in
+    ``y``, so ``y`` never drops one. The middle token is within ``1/5 < h`` in ``x`` as
+    well and is always held. The left token is held exactly when ``x <= c + 3/20`` and
+    the right one exactly when ``x >= c - 3/20``, and no ``x`` fails both, so at least
+    two of the three tokens are held and the atom charges its weight ``1``. The outer
+    tokens really are dropped at the diamond's extremes -- at ``x = c + 1/5`` the left
+    one is ``8/20`` away against ``h = 7/20`` -- which is what makes the ``2`` of the
+    ``2-of-3`` load-bearing rather than decorative. The same argument in ``y`` charges
+    the vertical atom, so every clipped centre carries charge ``1 + 1 = 2``.
+    """
+    certificate = _tiny_certificate()
+    direction = certificate.directions[0]
+    plain, _ = minimum_charge(
+        certificate.atoms,
+        certificate.threshold_atoms,
+        direction,
+        TINY_SIDE,
+        TINY_SHRINK,
+    )
+    assert plain == 0
+    clipped, witness = minimum_charge(
+        certificate.atoms,
+        certificate.threshold_atoms,
+        direction,
+        TINY_SIDE,
+        TINY_SHRINK,
+        clip=_tiny_clip(),
+    )
+    assert clipped == 2
+    # The witness is a centre of the clipped domain, which at this direction is the
+    # diamond of the docstring: the rotated frame is the container's own.
+    u, v = witness
+    assert abs(u - TINY_SIDE / 2) <= TINY_OFFSET
+    assert abs(v - TINY_SIDE / 2) <= TINY_OFFSET
+
+
+def test_the_clip_is_what_decides_the_tiny_threshold_certificate() -> None:
+    certificate = _tiny_certificate()
+    plain = verify_threshold(certificate, workers=1)
+    assert not plain.accepted
+    assert plain.failures == (CONDITION_5_PRIME,)
+    assert plain.minimum_cell_mass == 0
+    clipped = verify_threshold(certificate, workers=1, clip=_tiny_clip())
+    assert clipped.accepted
+    assert clipped.minimum_cell_mass == 1
+
+
+def test_the_clip_reaches_the_forked_workers_on_both_routes() -> None:
+    """The clip is installed beside the certificate, not carried by the task.
+
+    A worker that inherited the certificate and dropped the clip would sweep the full
+    domain and report ``0`` here, so this is the control on the threading and not a
+    second control on the geometry. Both parallel routes are covered: the sweep's
+    ``initargs`` and the interval route's ``partial``.
+    """
+    certificate = _tiny_certificate()
+    clip = _tiny_clip()
+    assert verify_threshold(certificate, workers=2, clip=clip).minimum_cell_mass == 1
+    assert verify_threshold(certificate, workers=2).minimum_cell_mass == 0
+    parallel = verify_threshold_by_intervals(certificate, enclose=True, workers=2, clip=clip)
+    assert parallel.accepted
+    assert parallel.enclosure == (Fraction(1), Fraction(1))
+
+
+def test_both_routes_agree_on_the_number_under_the_clip() -> None:
+    """The gate's own requirement, on a clipped domain: one value, enclosure width zero."""
+    certificate = _tiny_certificate()
+    clip = _tiny_clip()
+    exact = verify_threshold(certificate, workers=1, clip=clip)
+    interval = verify_threshold_by_intervals(certificate, enclose=True, clip=clip)
+    assert interval.accepted
+    enclosure = interval.enclosure
+    assert enclosure is not None
+    assert enclosure[0] == enclosure[1] == exact.minimum_cell_mass
+    assert all(outcome.stalled == 0 for outcome in interval.directions)
+    # And the interval route refuses the same certificate on the full domain, so the two
+    # are agreeing about the clip and not about a certificate that never needed one.
+    plain = verify_threshold_by_intervals(certificate, enclose=True)
+    assert not plain.accepted
+    assert plain.failures == (CONDITION_5,)
+
+
+def test_clipping_can_only_raise_the_least_charge() -> None:
+    """Cutting placements out of a covering program cannot lower its worst one."""
+    certificate = _tiny_certificate()
+    clip = _tiny_clip()
+    for direction in certificate.directions:
+        plain, _ = minimum_charge(
+            certificate.atoms, certificate.threshold_atoms, direction, TINY_SIDE, TINY_SHRINK
+        )
+        clipped, _ = minimum_charge(
+            certificate.atoms,
+            certificate.threshold_atoms,
+            direction,
+            TINY_SIDE,
+            TINY_SHRINK,
+            clip=clip,
+        )
+        assert clipped >= plain
+
+
+def test_a_witness_inside_a_corner_triangle_is_not_admissible_under_the_clip() -> None:
+    """A refutation of the class has to exhibit a centre the class can carry."""
+    certificate = _tiny_certificate()
+    # Inside the container domain with room to spare -- the float is read as an exact
+    # rational, so a centre on the margin itself would be decided by its last bit -- and
+    # deep inside the corner triangle, where ``x + y = 4/5`` against the cut at ``17/10``.
+    corner = (0.4, 0.4)
+    plain = exact_charge_at_witness(certificate, "0", corner)
+    assert plain.admissible
+    assert plain.charge == 0
+    clipped = exact_charge_at_witness(certificate, "0", corner, _tiny_clip())
+    assert not clipped.admissible
+    # The charge is a property of the placement and not of the domain, so it is the same
+    # number either way: only admissibility moves.
+    assert clipped.charge == plain.charge
+
+
+def test_a_clip_that_removes_everything_is_a_refusal_and_not_a_vacuous_pass() -> None:
+    """An empty class has nothing to quantify over, so Condition 5' must fail, not pass."""
+    small = Fraction(3, 2)
+    certificate = _tiny_certificate(small)
+    clip = _tiny_clip(small)
+    with pytest.raises(EmptyClippedDomainError):
+        minimum_charge(
+            certificate.atoms,
+            certificate.threshold_atoms,
+            certificate.directions[0],
+            small,
+            TINY_SHRINK,
+            clip=clip,
+        )
+    verdict = verify_threshold(certificate, workers=1, clip=clip)
+    assert not verdict.accepted
+    assert verdict.failures == (CONDITION_5_PRIME,)
+    assert verdict.minimum_cell_mass is None
+
+
+# --- the gate's variant policy ------------------------------------------------
+
+
+def _record(
+    clip: CornerClip | None, least: str, side: Fraction = TINY_SIDE
+) -> dict[str, object]:
+    """The frozen record of the tiny certificate, clipped or not.
+
+    The clipped form is what `sqpack.fractional.corner_clip` prescribes -- ``variant:
+    class``, the threshold in ``corner_clip``, the class's claim and the class's id --
+    and the unclipped form is what this gate has always read.
+    """
+    certificate = _tiny_certificate(side)
+    side = certificate.outer_side
+    record: dict[str, object] = {
+        "id": f"C-n{certificate.n:03d}-threshold-{side.numerator}-{side.denominator}",
+        "variant": "threshold",
+        "n": certificate.n,
+        "claim": f"s({certificate.n}) >= {side}",
+        "outer_side": str(side),
+        "square_side": str(certificate.square_side),
+        "angle_limit": str(TINY_NET[-1]),
+        "direction_steps": len(TINY_NET) - 1,
+        "symmetry": "D4",
+        "total_budget": str(certificate.total_budget),
+        "least_cell_charge": least,
+        "atoms": [],
+        "threshold_atoms": [t.to_record() for t in certificate.threshold_atoms],
+    }
+    if clip is not None:
+        depth = clip.depth
+        base = f"C-n{certificate.n:03d}-threshold-{side.numerator}-{side.denominator}"
+        record["id"] = f"{base}-clip-{depth.numerator}-{depth.denominator}"
+        record["variant"] = "class"
+        record["corner_clip"] = str(depth)
+        record["claim"] = f"corner class d = {depth} excluded at s({certificate.n}) >= {side}"
+    return record
+
+
+def _write(tmp_path: Path, record: dict[str, object]) -> Path:
+    path = tmp_path / "candidate.json"
+    path.write_text(json.dumps(record, indent=1) + "\n")
+    return path
+
+
+def test_the_gate_decides_a_clipped_record_only_when_asked_for_that_clip(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    path = _write(tmp_path, _record(_tiny_clip(), "1"))
+    # Without the flag the record is refused by name: reading it unclipped would print
+    # this gate's own sentence over bytes that never claimed it.
+    assert gate_main([str(path)]) == 1
+    assert "variant: class" in capsys.readouterr().out
+    # With a different threshold it is refused for disagreeing with its own bytes.
+    assert gate_main([str(path), "--corner-clip", "1/2"]) == 1
+    assert "declared corner_clip" in capsys.readouterr().out
+    # With the threshold it declares, both routes decide it and say what it is.
+    assert gate_main([str(path), "--corner-clip", "1"]) == 0
+    printed = capsys.readouterr().out
+    assert "RETAINABLE UNDER THE CORNER CLASS HYPOTHESIS" in printed
+    assert "corner clip d = 1" in printed
+    assert "RETAINABLE: " not in printed
+
+
+def test_an_unclipped_record_is_refused_under_the_flag(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """The other half of the policy: the flag does not clip bytes that never asked.
+
+    The refusal names the variant the record declares, as the point gate's does, so the
+    operator is told which of the two -- the flag or the file -- is the one to change.
+    """
+    path = _write(tmp_path, _record(None, "0"))
+    assert gate_main([str(path), "--corner-clip", "1"]) == 1
+    printed = capsys.readouterr().out
+    assert "variant 'threshold' is declared" in printed
+    assert "decides only 'class' certificates" in printed
+
+
+def test_a_record_carrying_a_clip_without_the_class_variant_is_refused(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
