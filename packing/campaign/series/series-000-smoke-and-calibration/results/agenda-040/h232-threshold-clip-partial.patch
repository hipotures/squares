+def test_the_gate_refuses_an_empty_class_rather_than_raising(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str]
+) -> None:
+    """The exact route's refusal, read through the gate: a message, not a traceback.
+
+    The interval route cannot see the emptiness itself: its exclusion rule drops a box
+    only when the box is *provably* inside a corner triangle, so an empty domain reaches
+    it as no surviving box and it accepts, having refuted nothing. Here it still refuses,
+    because a search that examined nothing pins no enclosure -- but that is a
+    consequence and not the reason, so the gate is also held to the exact route's own
+    sentence under ``--exact-only``, where nothing else can produce it.
+    """
+    small = Fraction(3, 2)
+    path = _write(tmp_path, _record(_tiny_clip(small), "1", small))
+    assert gate_main([str(path), "--corner-clip", "1"]) == 1
+    assert "no enclosure to compare" in capsys.readouterr().out
+    assert gate_main([str(path), "--corner-clip", "1", "--exact-only"]) == 1
+    assert "the corner clip admits no placement" in capsys.readouterr().out
