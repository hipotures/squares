    def test_reference_keeps_a_feasible_open_cell_thinner_than_its_search_cap() -> None:
        """A rational wall at 7/10 cuts a nonempty synthetic zero-charge cell."""
        spec = importlib.util.spec_from_file_location(
            "reviewed_reader_controls", REPO / "packing/tests/test_bc303_t2_charge_sweep.py"
        )
        assert spec is not None and spec.loader is not None
        controls = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(controls)
        c, s = Fraction(4, 5), Fraction(3, 5)
        chart = Chart(1, False, (c, s), Fraction(3, 4), Fraction(1), H - DELTA * (c - s))
        x_high = Fraction(1, 1000)
        epsilon = Fraction(1, 2**100)
        y_low = (A + c * x_high - Fraction(7, 10) - epsilon) / s
        assert 0 < y_low < H
        atoms = (
            AtomMass(centre_of(chart, x_high + H, H / 2), 1),
            AtomMass(centre_of(chart, H / 2, y_low - H), 1),
        )
        minimum, _, _ = sweep_chart(chart, atoms)
        reference, _ = controls.direct_all_strata_minima(chart, atoms)
        # This explicit point proves the missed zero-charge cell is nonempty.
        x = x_high - x_high / 2**110
        y = y_low + (H - y_low) / 2**110
        centre = centre_of(chart, x, y)
        assert centre[0] > Fraction(7, 10)
        assert charge_at(atoms, centre, chart.selected_ray) == 0
        print(json.dumps({
            "scope": "Synthetic atoms and rational synthetic wall only",
