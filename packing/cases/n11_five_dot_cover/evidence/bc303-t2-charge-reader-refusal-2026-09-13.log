role = 'C'

    @pytest.mark.parametrize("role", ["C", "S_first_owner"])
    def test_reflected_parent_inverse_transport_matches_declared_source(role: str) -> None:
        chart = next(chart for chart in charts() if chart.index == 180 and chart.reflected)
        atoms = (
            AtomMass(centre_of(chart, H, H), 3),
            AtomMass(centre_of(chart, chart.x_cut / 2 + H, H / 2), 5),
            AtomMass(centre_of(chart, H / 3, H / 3), 7),
        )
        c_minimum, s_minimum, _ = sweep_chart(chart, atoms)
        minimum = c_minimum if role == "C" else s_minimum
        receipt = replay(minimum, atoms, role)
        ux, uy = map(Fraction, receipt["physical_parent_ray"])
        # All eligible non-axis reflected charts have positive physical coordinates.
        # Undo the source's coordinate swap before testing its folded angular cell.
        source_tangent = ux / uy
        valid = chart.lower_tangent <= source_tangent <= chart.upper_tangent
        print(json.dumps({
            "receipt": receipt,
            "lower_source_tangent": str(chart.lower_tangent),
            "upper_source_tangent": str(chart.upper_tangent),
            "inverse_reflected_source_tangent": str(source_tangent),
            "source_cell_valid": valid,
            "scope": "Synthetic atoms only; no BC293 source measure loaded or charged",
        }, sort_keys=True))
